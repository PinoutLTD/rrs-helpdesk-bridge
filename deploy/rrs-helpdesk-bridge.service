[Unit]
Description=Files Robonomics reports as Odoo helpdesk tickets
Documentation=https://github.com/PinoutLTD/rrs-helpdesk-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rrs-bridge
Group=rrs-bridge
WorkingDirectory=/mnt/disk/pinout-report-service/rrs-helpdesk-bridge
Environment=PROTON_PASS_SESSION_DIR=/var/lib/rrs-bridge/pass-session
# The token file stays root-only; systemd hands a copy to this unit alone.
LoadCredential=token:/etc/rrs/bridge.token
# Dry run until the first tickets have been checked by hand: add --write to
# this line (and reload) to let it file them.
ExecStart=/mnt/disk/pinout-report-service/rrs-helpdesk-bridge/deploy/session.sh \
    /mnt/disk/pinout-report-service/rrs-helpdesk-bridge/.venv/bin/rrs-helpdesk-bridge \
    --command run-once

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Its own state only: the connector's reports are read through the shared group.
ReadWritePaths=/mnt/disk/pinout-report-service/data/bridge /var/lib/rrs-bridge
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
